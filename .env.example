# Memstream environment
#
# Local try-out (make demo-local / make web shop): leave this file alone — no .env needed.
# Cloud path: cp .env.example .env and uncomment/fill the sections below.
#
# Quote every Cockroach URL — unquoted & in query strings breaks shell `source .env`.
# Prefer sslmode=verify-full without sslrootcert= — use PGSSLROOTCERT / make cockroach-ca.

# --- Cluster bootstrap (make setup-db) ---
# CLUSTER_URL='postgresql://user:password@host:26257/defaultdb?sslmode=verify-full'
# Cockroach Cloud cluster id (Overview) for `make cockroach-ca`:
# COCKROACH_CLUSTER_ID=
# PGSSLROOTCERT=$HOME/.postgresql/root.crt

# --- Platform DB (required for console + cloud worker cursor) — .env only ---
# After make setup-db, use the printed memstream URL (or set to .../memstream).
# MEMSTREAM_DATABASE_URL='postgresql://user:password@host:26257/memstream?sslmode=verify-full'

# Required to encrypt application DATABASE_URL at rest (Connect).
# openssl rand -hex 32
# MEMSTREAM_SECRETS_KEY=

# Shared application DB for "Use demo workspace" (skip Connect paste).
# Server-only — never put customer secrets in the client.
# If unset, Memstream derives …/application from MEMSTREAM_DATABASE_URL when
# the platform URL path is /memstream (matches make setup-db).
# DEMO_APPLICATION_DATABASE_URL='postgresql://user:password@host:26257/application?sslmode=verify-full'

# Optional console API token (Bearer). Set both for browser + server:
# MEMSTREAM_CONSOLE_TOKEN=
# NEXT_PUBLIC_MEMSTREAM_CONSOLE_TOKEN=
# (Demo-only: embedding the token in NEXT_PUBLIC_ is not multi-tenant safe.)

# Demo console login (username/password → hashed in memstream_operators).
# When MEMSTREAM_DATABASE_URL is set, / redirects to /login until signed in.
# Defaults: demo / demo (override below). Set MEMSTREAM_AUTH_DISABLED=1 to skip.
# MEMSTREAM_DEMO_USER=demo
# MEMSTREAM_DEMO_PASSWORD=demo
# MEMSTREAM_AUTH_REQUIRED=1
# MEMSTREAM_AUTH_DISABLED=1
#
# Memstream MCP (/api/mcp) uses the same gate when platform auth is on:
#   - Authorization: Basic base64(demo:demo)  — Cursor headers (Copy MCP includes this)
#   - or Authorization: Bearer <token> via MEMSTREAM_MCP_TOKEN (falls back to CONSOLE token)
# MEMSTREAM_MCP_TOKEN=
# Cockroach Cloud MCP is separate (Cloud console OAuth) — Memstream MCP does not
# call Cloud with demo/demo; it uses the app DATABASE_URL stored at Connect.
# Cross-links (local defaults):
# NEXT_PUBLIC_SHOP_URL=http://127.0.0.1:3001
# NEXT_PUBLIC_MEMSTREAM_URL=http://127.0.0.1:3000

# --- Local defaults (optional) ---
MEMSTREAM_SOURCE=filesystem
MEMSTREAM_EVENTS_DIR=data/cdc/inbox
MEMSTREAM_EMBEDDER=fake
MEMSTREAM_STORE=memory
# Which profile id to use (content lives in Cockroach memstream_profiles).
# Legacy path form still works: profiles/commerce.yaml → id commerce
MEMORY_PROFILE=commerce
SHOP_BACKEND=memory
# Force local JSON cursor only for offline/tests (omit for Memstream DB cursor):
# MEMSTREAM_STATE_FILE=.memstream-fs-state.json

# --- Ops / change storage (required for Enable; not shown in Connect UI) ---
# AWS_REGION=us-east-1
# CDC_S3_BUCKET=memstream-cdc-yourname
# CDC_S3_PREFIX=cdc/
# BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# MEMSTREAM_SOURCE=s3
# MEMSTREAM_EMBEDDER=bedrock
# MEMSTREAM_STORE=cockroach
# MEMSTREAM_WATCH=true
# MEMSTREAM_POLL_INTERVAL=5
# SHOP_BACKEND=cockroach
# SHOP_ALSO_EMIT_LOCAL=false

# Optional keyless CDC sink (Cockroach Cloud AUTH=implicit + ASSUME_ROLE):
# MEMSTREAM_CDC_ROLE_ARN=arn:aws:iam::123456789012:role/memstream-cdc
# MEMSTREAM_CDC_EXTERNAL_ID=
# Otherwise Enable embeds (often temporary) AWS keys in EXTERNAL CONNECTION.

# Cloud worker when Enable deploys (platform .env only; default lambda):
# MEMSTREAM_WORKER_COMPUTE=lambda   # or ec2 (self-host / demo box)

# Application DATABASE_URL is set in the Connect UI and stored encrypted in
# memstream_connections — do not put customer app URLs in .env for BYO Connect.
# Connect also supports Cockroach Cloud: paste a service-account API key, pick
# cluster / SQL user / database, preview accessible tables, then Continue.
# Judge / demo skip-Connect uses DEMO_APPLICATION_DATABASE_URL (or derive from
# MEMSTREAM_DATABASE_URL …/memstream → …/application). Deploy does not require it.
# Allow Propose against localhost/private hosts (default blocked):
# MEMSTREAM_ALLOW_PRIVATE_DB_URL=1

# --- Memstream MCP (search_memory) ---
# Scopes search to the active application connection when set (or use --connection-id).
# MEMSTREAM_CONNECTION_ID=
# Preferred: Copy Memstream MCP from the console while `make web` runs
# (http://127.0.0.1:3000/api/mcp). Standalone: `make mcp` (HTTP :8765).
# MEMSTREAM_MCP_TRANSPORT=http
# MEMSTREAM_MCP_HOST=127.0.0.1
# MEMSTREAM_MCP_PORT=8765
# MEMSTREAM_MCP_PUBLIC_URL=http://127.0.0.1:3000
# MEMSTREAM_SEARCH_TOP_K=5
# Host/Origin allowlists (comma-separated). Unset Host → localhost only.
# MEMSTREAM_MCP_ALLOWED_HOSTS=your.example.com:*
# MEMSTREAM_MCP_ALLOWED_ORIGINS=https://your.example.com

# --- EC2 demo box / Lambda worker (make deploy-aws or Enable) — see docs/AWS.md ---
# STACK_NAME=memstream-demo
# MEMSTREAM_WORKER_COMPUTE=lambda
# INSTANCE_TYPE=t3.micro
# Default ShopCidr is 0.0.0.0/0 (open for demos). Tighten for real use:
# SHOP_CIDR=x.x.x.x/32
# KEY_NAME=
# Docker required for make deploy-aws (Colima / OrbStack / Desktop).
# On Apple Silicon Colima, deploy defaults to linux/arm64 + t4g.micro (qemu amd64 crashes next build).
# Override: MEMSTREAM_DEPLOY_PLATFORM=linux/amd64 INSTANCE_TYPE=t3.micro
# DEPLOY_OBJECT_KEY=deploy/memstream-prebuilt.tgz
# INSTANCE_TYPE=t4g.micro
