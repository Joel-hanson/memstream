# Copy to apps/web/.env.local if needed (or use monorepo root .env).
#
# Platform DB — connections, run history, CDC cursor (.env only; not Connect UI)
# MEMSTREAM_DATABASE_URL=postgresql://user:password@host:26257/memstream?sslmode=verify-full
# MEMSTREAM_SECRETS_KEY=   # required: openssl rand -hex 32
#
# Console token (also set NEXT_PUBLIC_… for the browser):
# MEMSTREAM_CONSOLE_TOKEN=
# NEXT_PUBLIC_MEMSTREAM_CONSOLE_TOKEN=
#
# Cloud worker when Enable deploys (default lambda):
# MEMSTREAM_WORKER_COMPUTE=lambda   # or ec2 for self-host / demo
# Application DATABASE_URL is stored via Connect → memstream_connections (encrypted).
# Skip-Connect demo workspace (optional; else derived from …/memstream → …/application):
# DEMO_APPLICATION_DATABASE_URL=postgresql://user:password@host:26257/application?sslmode=verify-full
# TLS: PGSSLROOTCERT / make cockroach-ca — URLs use sslmode=verify-full only.
