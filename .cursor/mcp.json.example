{
  "mcpServers": {
    "cockroachdb-cloud": {
      "type": "http",
      "url": "https://cockroachlabs.cloud/mcp",
      "headers": {
        "mcp-cluster-id": "YOUR_CLUSTER_ID"
      }
    },
    "memstream": {
      "url": "https://YOUR_HOST/api/mcp",
      "headers": {
        "Authorization": "Basic YOUR_BASIC_CREDENTIALS"
      }
    }
  }
}
